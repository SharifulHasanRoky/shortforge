# ShortForge Environment Variables
# Copy this to .env (or set in Render/Railway dashboard)

# === Database (REQUIRED) ===
# For local dev (SQLite):
# DATABASE_URL=file:./db/custom.db
#
# For production (Supabase PostgreSQL - FREE):
# 1. Sign up at https://supabase.com (free, no credit card)
# 2. Create a new project
# 3. Go to Settings → Database → Connection string → URI
# 4. Copy the connection string (looks like: postgresql://postgres:PASSWORD@db.XXX.supabase.co:5432/postgres)
# 5. Set DATABASE_URL to that string
DATABASE_URL=postgresql://postgres:PASSWORD@db.XXX.supabase.co:5432/postgres

# === Storage (auto-set in Docker, optional for dev) ===
# Where to store generated videos, audio, images
# Default: /home/z/my-project/storage (local dev) or /app/storage (Docker)
# STORAGE_ROOT=/app/storage

# === Optional ===
# Public URL of your deployment (for YouTube OAuth redirect URI)
# Set this to your Render/Railway URL after deploy
# NEXT_PUBLIC_APP_URL=https://your-app.onrender.com

# === Notes ===
# - z-ai-web-dev-sdk reads its API key from environment automatically
# - YouTube OAuth credentials are stored in the database (entered via Settings tab)
# - No other env vars needed
