# ShortForge Environment Variables
# Copy this to .env (or set in Railway dashboard)

# Database (SQLite - file is created automatically)
DATABASE_URL=file:/app/db/custom.db

# Optional: Set this to your Railway public URL for YouTube OAuth redirect
# Example: https://shortforge-production.up.railway.app
# NEXT_PUBLIC_APP_URL=

# Note: z-ai-web-dev-sdk reads its API key from environment automatically.
# No additional env vars needed for that.

# YouTube OAuth credentials are stored in the database (Settings tab in app).
# You don't need to set them here - they're entered via the UI after deploy.
